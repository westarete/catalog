<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.westarete.catalog</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Users/YOUR_NAME/bin/catalog</string>
		<string>daemon</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>StandardOutPath</key>
	<string>/Users/YOUR_NAME/Library/Logs/catalog.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/YOUR_NAME/Library/Logs/catalog.log</string>
</dict>
</plist>
