<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.westarete.catalog</string>
	<key>ProgramArguments</key>
	<array>
		<string>CATALOG_PROGRAM</string>
		<string>daemon</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<!-- 63 is octal 077: the log and every file the daemon creates are
	     readable only by their owner. launchd.plist(5) says it creates the
	     log files with this umask. -->
	<key>Umask</key>
	<integer>63</integer>
	<key>StandardOutPath</key>
	<string>YOUR_HOME/Library/Logs/catalog.log</string>
	<key>StandardErrorPath</key>
	<string>YOUR_HOME/Library/Logs/catalog.log</string>
</dict>
</plist>
